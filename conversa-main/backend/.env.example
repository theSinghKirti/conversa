NODE_ENV=development
PORT=5500

MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGO_DB_NAME=conversa
JWT_SECRET=<replace-with-long-random-secret>

FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

EMAIL=<smtp-email>
PASSWORD=<smtp-app-password>

AWS_BUCKET_NAME=<s3-bucket-name>
AWS_ACCESS_KEY=<aws-access-key-id>
AWS_SECRET=<aws-secret-access-key>

# Google Gemini API (Reasoning / Drafter)
GEMINI_API_KEY=<gemini-api-key>
GEMINI_MODEL=gemini-3-flash-preview

# Hugging Face Embedding Provider (1024-dim BAAI/bge-large-en-v1.5)
HUGGINGFACE_API_KEY=<huggingface-api-token>
HUGGINGFACE_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# Groq Reasoning Provider (e.g., llama-3.3-70b-versatile)
GROQ_API_KEY=<groq-api-key>
GROQ_MODEL=llama-3.3-70b-versatile

# Admin seed credentials - only used by: npm run seed:admin
ADMIN_NAME=<admin-name>
ADMIN_EMAIL=<admin@example.com>
ADMIN_PASSWORD=<strong-admin-password>
